<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ChartingSystem.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:ChartingSystem"
    xmlns:view="clr-namespace:MAUI.ChartingSystem.Views"
    Title="ChartingSystem">

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />

    <ShellContent
        Title="Patients"
        ContentTemplate="{DataTemplate local:PatientsPage}"
        Route="PatientsPage" />
    <ShellContent
        Title="PatientDetail"
        ContentTemplate="{DataTemplate view:PatientView}"
        Route="Patient" />

</Shell>
