<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ChartingSystem.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            <Label
                Text="Hello!"
                Style="{StaticResource Headline}"
                SemanticProperties.HeadingLevel="Level1" />

            <Label
                Text="What would you like to view today?"
                Style="{StaticResource SubHeadline}"
                SemanticProperties.HeadingLevel="Level2" />

            <Button
                x:Name="PatientsBtn"
                Text="Patients" 
                Clicked="OnPatientsClicked"
                HorizontalOptions="Fill" />

            <Button
                x:Name="PhysiciansBtn"
                Text="Physicians" 
                Clicked="OnPhysiciansClicked"
                HorizontalOptions="Fill" />

            <Button
                x:Name="AppointmentsBtn"
                Text="Appointments" 
                Clicked="OnAppointmentsClicked"
                HorizontalOptions="Fill" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
