<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MAUI.ChartingSystem.Views.AppointmentView"
             Title="AppointmentView"
             NavigatedTo="AppointmentPage_NavigatedTo">
    <VerticalStackLayout>
        <Label Text="Patient ID" />
        <Entry Text="{Binding PatId}" />

        <Label Text="Physician ID" />
        <Entry Text="{Binding PhysId}" />

        <Label Text="Date" />
        <Entry Text="{Binding Date}" />

        <Label Text="Time" />
        <Entry Text="{Binding Time}" />
        
        <Button Text="OK" Clicked="OkClicked" />
        <Button Text="Cancel" Clicked="CancelClicked"/>
    </VerticalStackLayout>
</ContentPage>